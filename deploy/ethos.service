[Unit]
Description=ETHOS (aiethos.ru) Next.js server
After=network.target
# Never stop trying to restart — disable the "start-limit hit, giving up" state.
StartLimitIntervalSec=0

[Service]
Type=simple
# Directory where the repo is cloned on the server (app lives in ./nextjs)
WorkingDirectory=/opt/ethos/nextjs
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# Absolute path to npm so systemd finds it regardless of PATH
ExecStart=/usr/bin/npm run start
# Restart on ANY exit (crash, clean exit, OOM) after a short pause.
Restart=always
RestartSec=3
TimeoutStartSec=90
# If the kernel OOM-kills a child, restart the service instead of giving up.
OOMPolicy=continue
User=root

[Install]
WantedBy=multi-user.target
